<h1 class="text-center mt-4">Articles</h1>

<div class="container">
  <% @articles.each do |article| %>
    <div class="row justify-content-center">
      <div class="col-8 mt-4">
        <div class="card text-center">
          <div class="card-header">
            by Anaflavia
          </div>
          <div class="card-body">
            <h5 class="card-title">
              <%= link_to article.title, article_path(article) %>
            </h5>
            <p class="card-text">
              <%= article.description %>
            </p>
            
            <div>
              <%= link_to 'Show', article_path(article), class: "btn btn-outline-primary me-2" %>
              <%= link_to 'Edit', edit_article_path(article), class: "btn btn-outline-primary me-2" %>
              <%= link_to 'Delete', article_path(article), data: { turbo_method: :delete, turbo_confirm: "Are you sure?" }, class: "btn btn-outline-primary me-2" %>
            </div>

          </div>
          <div class="card-footer text-muted">
            Created <%= time_ago_in_words(article.created_at) %> ago, edited <%= time_ago_in_words(article.updated_at) %> ago
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>

<%# Enlace para crear un nuevo articulo %>
<p>
  <%= link_to 'New Article', new_article_path %>
</p>