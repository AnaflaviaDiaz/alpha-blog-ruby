<% if @article.errors.any? %>
  <h2>The following errors prevented the article from being saved</h2>
  <ul>
    <% @article.errors.full_messages.each do |msg| %>
      <li><%= msg %></li>
    <% end %>
  </ul>
<% end %>

<%# en los métodos que se usen, como create y update, se debe usar  %>
<%# article_params para manejar los parámetros permitidos,  %>
<%# en lugar de acceder directamente a params[:article] o  %>
<%# params[:article][:title], etc. Esto es una buena práctica de seguridad  %>
<%# para evitar la asignación masiva de atributos no deseados. %>
<%# Al final, en articles_controller debe tener valor la variable @article %>
<%# data: { turbo: false } en el formulario para asegurar que Turbo no lo intercepte %>
<%= form_with(model: @article, local: true, data: { turbo: false }) do |f| %>
  <div class="mb-3">
    <%= f.label :title, for: "titleControl", :class => "form-label" %>
    <%= f.text_field :title, id: "titleControl",  :class => "form-control", :placeholder => "my title" %>
  </div>
  <div class="mb-3">
    <%= f.label :description, for: "descriptionControl", :class => "form-label" %>
    <%= f.text_area :description, id: "descriptionControl", :class => "form-control", rows: 3 %>
  </div>

  <p>
    <%= f.submit "Save", type: "submit", :class=> "btn btn-primary" %>
  </p>
<% end %>